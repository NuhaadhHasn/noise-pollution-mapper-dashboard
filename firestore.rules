rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Noise Readings Collection
    match /noise_readings/{document} {
      // Users can read their own readings
      allow read: if isAuthenticated() && (
        // Read own readings
        resource.data.userId == request.auth.uid ||
        // Admins can read all readings (for cache export)
        isAdmin()
      );
      
      // Users can create their own readings
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own readings
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Users Collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && 
        (userId == request.auth.uid || isAdmin());
      
      // Users can create their own profile
      allow create: if isAuthenticated() && 
        userId == request.auth.uid;
      
      // Users can update their own profile
      allow update: if isAuthenticated() && 
        userId == request.auth.uid;
      
      // Users can delete their own profile
      allow delete: if isAuthenticated() && 
        userId == request.auth.uid;
    }
  }
}
